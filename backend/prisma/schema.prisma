generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDENADOR
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LoginThrottleScope {
  ACCOUNT
  IP
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role
  jobTitle        String?   @map("job_title")
  bio             String?
  area            String?
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdArticles Article[] @relation("article_created_by")
  authSessions    AuthSession[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginThrottle {
  key             String             @id
  scope           LoginThrottleScope
  attemptCount    Int                @default(0) @map("attempt_count")
  lockLevel       Int                @default(0) @map("lock_level")
  windowStartedAt DateTime           @map("window_started_at")
  blockedUntil    DateTime?          @map("blocked_until")
  expiresAt       DateTime           @map("expires_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([scope, expiresAt])
  @@index([expiresAt])
  @@map("login_throttles")
}

model Author {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  bio       String?
  area      String?
  avatarUrl String?         @map("avatar_url")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  articles  ArticleAuthor[]

  @@index([name])
  @@map("authors")
}

model Area {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique @map("normalized_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  articles       Article[]

  @@index([name])
  @@map("areas")
}

model Event {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  edition          String
  year             Int
  date             String
  area             String
  type             String
  viewCount        Int       @default(0) @map("view_count")
  coverUrl         String?   @map("cover_url")
  presentation     String
  themes           String[]
  committee        Json?
  rules            Json?
  previousEditions Json?     @map("previous_editions")
  contactEmail     String    @map("contact_email")
  contactPhone     String?   @map("contact_phone")
  isbn             String?
  doi              String?
  publisher        String?
  address          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  articles         Article[]

  @@index([year])
  @@index([type])
  @@index([area])
  @@map("events")
}

model Article {
  id           String        @id @default(cuid())
  title        String
  abstract     String
  area         String
  areaId       String?       @map("area_id")
  pages        String?
  pdfUrl       String?       @map("pdf_url")
  viewCount    Int           @default(0) @map("view_count")
  downloadCount Int          @default(0) @map("download_count")
  status       ArticleStatus @default(DRAFT)
  modality     String?
  importedFrom String?       @map("imported_from")
  externalId   String?       @map("external_id")
  submittedAt  DateTime      @default(now()) @map("submitted_at")
  importedAt   DateTime?     @map("imported_at")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  createdById  String?       @map("created_by_id")
  areaRef      Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String        @map("event_id")
  createdBy    User?         @relation("article_created_by", fields: [createdById], references: [id], onDelete: SetNull)
  authors      ArticleAuthor[]

  @@index([status])
  @@index([area])
  @@index([areaId])
  @@index([eventId])
  @@map("articles")
}

model ArticleAuthor {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String  @map("article_id")
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String  @map("author_id")
  position  Int     @default(0)

  @@id([articleId, authorId])
  @@index([authorId])
  @@map("article_authors")
}
