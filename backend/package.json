    "fastify-plugin": "^5.1.0",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "pdf-lib": "^1.17.1",
